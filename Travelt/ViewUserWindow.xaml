<Window x:Class="Travelt.ViewUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View User"
        Height="650"
        Width="1000"
        Background="#1A0B2E"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <TextBlock x:Name="PageHeader"
                   Text="User Profile"
                   Foreground="White"
                   FontSize="60"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,25"/>

        
        <Grid Grid.Row="1" Margin="25,0,25,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>

            
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0"
                        Background="#2B124C"
                        Padding="20"
                        Margin="0,0,0,15">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        
                        <Border Grid.Column="0"
                                Width="210"
                                Height="210"
                                Background="#FF2D8C"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                            <TextBlock Text="Profile Picture"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        
                        <StackPanel Grid.Column="1"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Top">

                            <TextBlock x:Name="Username_Text"
                                       Text="Username"
                                       Foreground="White"
                                       FontSize="34"
                                       FontFamily="Comic Sans MS"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <TextBlock x:Name="Age_Text"
                                       Text="Age:"
                                       Foreground="White"
                                       FontFamily="Comic Sans MS"
                                       FontSize="22"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="Rank_Text"
                                       Text="Rank:"
                                       Foreground="White"
                                       FontFamily="Comic Sans MS"
                                       FontSize="22"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="Rating_Text"
                                       Text="Rating:"
                                       Foreground="White"
                                       FontFamily="Comic Sans MS"
                                       FontSize="22"
                                       Margin="0,0,0,8"/>

                        </StackPanel>
                    </Grid>
                </Border>

                
                <Expander Grid.Row="1"
                          Header="Bio"
                          Background="#2B124C"
                          Foreground="White"
                          FontSize="22"
                          FontFamily="Comic Sans MS"
                          Padding="12"
                          Margin="0,0,0,15"
                          IsExpanded="True">

                    <TextBlock x:Name="BioBlock"
                               Text="No Bio Yet"
                               Foreground="White"
                               FontFamily="Comic Sans MS"
                               FontSize="18"
                               TextWrapping="Wrap"
                               Margin="10"/>
                </Expander>

                
                <Expander Grid.Row="2"
                          Header="Achievements"
                          Background="#2B124C"
                          Foreground="White"
                          FontSize="22"
                          FontFamily="Comic Sans MS"
                          Padding="12"
                          Margin="0,0,0,0">

                    <WrapPanel x:Name="AchievementsPanel"
                               Margin="10">
                        <Border Background="#3B1A66"
                                CornerRadius="10"
                                Padding="12"
                                Margin="5">
                            <TextBlock Text="1st achievement"
                                       Foreground="White"
                                       FontSize="16"
                                       FontFamily="Comic Sans MS"/>
                        </Border>

                        <Border Background="#3B1A66"
                                CornerRadius="10"
                                Padding="12"
                                Margin="5">
                            <TextBlock Text="2nd Achievement"
                                       Foreground="White"
                                       FontSize="16"
                                       FontFamily="Comic Sans MS"/>
                        </Border>
                    </WrapPanel>
                </Expander>
            </Grid>

            
            <Border Grid.Column="1"
                    Background="#2B124C"
                    Padding="20"
                    Margin="15,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Trips"
                               Foreground="White"
                               FontSize="32"
                               FontFamily="Comic Sans MS"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TripsPanel">

                            
                            <Border Background="#3B1A66"
                                    CornerRadius="12"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="No public trips yet"
                                               Foreground="White"
                                               FontSize="22"
                                               FontFamily="Comic Sans MS"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="This section will show the user's public travel plans."
                                               Foreground="White"
                                               FontSize="16"
                                               FontFamily="Comic Sans MS"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="25,25,25,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Content="Back"
                    Width="160"
                    Height="45"
                    Foreground="White"
                    Background="#FF2D8C"
                    HorizontalAlignment="Left"
                    Click="Back_Button"/>

            <Button x:Name="ReportUserButton"
                    Grid.Column="1"
                    Content="Report User"
                    Width="160"
                    Height="45"
                    Foreground="White"
                    Background="#FF2D8C"
                    Margin="0,0,15,0"
                    Click="ReportUser_Button"/>

            <Button x:Name="EditUserButton"
                    Grid.Column="2"
                    Content="Edit User"
                    Width="160"
                    Height="45"
                    Foreground="White"
                    Background="#FF2D8C"
                    Visibility="Collapsed"
                    Click="EditUser_Button"/>
        </Grid>
    </Grid>
</Window>