<Window x:Class="Travelt.CreatePostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Create New Post" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1A001F">

        <Border Width="675" 
                Background="#F4F4F4" 
                CornerRadius="25" 
                Padding="25" 
                Margin="0,30,0,30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Create a New Post" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#1A001F" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,15"/>

                <Border Grid.Row="1" 
                        Background="White" 
                        CornerRadius="10" 
                        BorderThickness="2" 
                        BorderBrush="#E0E0E0"
                        Cursor="Hand"
                        Margin="0,0,0,15"
                        MouseLeftButtonDown="SelectImage_Click">
                    <Grid>
                        <StackPanel x:Name="PlaceholderUI" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="50" Foreground="#FF2D8C" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click to select an image" Foreground="DimGray" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border CornerRadius="8" ClipToBounds="True" Margin="5">
                            <Image x:Name="ImagePreview" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <TextBox x:Name="CaptionInput" 
                             Height="80" 
                             Padding="10,10,10,25" 
                             FontSize="14"
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             MaxLength="255"
                             TextChanged="CaptionInput_TextChanged"
                             Background="White" 
                             BorderThickness="1" 
                             BorderBrush="#E0E0E0"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock IsHitTestVisible="False" 
                               Text="Write a caption..." 
                               FontSize="14"
                               VerticalAlignment="Top" 
                               HorizontalAlignment="Left" 
                               Margin="12,12,0,0" 
                               Foreground="DarkGray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CaptionInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock x:Name="CharCountText"
                               Text="0/255"
                               FontSize="12"
                               Foreground="DarkGray"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,10,8"
                               IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Row="3" Height="45">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Content="Cancel" 
                            Background="#E0E0E0" 
                            Foreground="Black" 
                            FontWeight="Bold"
                            FontSize="15"
                            Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" 
                            Content="Post" 
                            Background="#FF2D8C" 
                            Foreground="White" 
                            FontWeight="Bold"
                            FontSize="15"
                            Cursor="Hand"
                            Click="Post_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>