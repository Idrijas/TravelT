<Window x:Class="Travelt.PlanningPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan a Trip" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1A0B2E">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,25,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="PLAN A TRIP!" 
                       Foreground="White" 
                       FontSize="45" 
                       FontFamily="Comic Sans MS" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,40"/>

            <Button Grid.Row="1" 
                    Background="#FF2D8C" 
                    Foreground="White" 
                    Cursor="Hand"
                    Margin="20,0,20,0"
                    Height="180"
                    VerticalAlignment="Top"
                    Click="AddTrip_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                    <TextBlock Text="Add Trip" FontSize="24" FontFamily="Comic Sans MS" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="2" 
                    Content="Back to Home" 
                    Height="45" 
                    Background="#3B1A66" 
                    Foreground="White" 
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="Back_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>


        <Border Grid.Column="1" 
                Background="#2B124C" 
                CornerRadius="25" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Your Trip History" 
                           Foreground="White" 
                           FontSize="28" 
                           FontFamily="Comic Sans MS" 
                           FontWeight="Bold" 
                           Margin="10,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="TripsList">

                        <Border Background="#3B1A66" CornerRadius="15" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Japan Summer Trip" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="Tokyo, Kyoto, Osaka" Foreground="#CCCCCC" FontSize="14" Margin="0,5,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Aug 2026" Foreground="#FF2D8C" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>