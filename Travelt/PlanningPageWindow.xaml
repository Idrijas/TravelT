<Window x:Class="Travelt.PlanningPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan a Trip" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1A0B2E">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,25,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="PLAN A TRIP!" 
                       Foreground="White" 
                       FontSize="45" 
                       FontFamily="Comic Sans MS" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,40"/>

            <Button Grid.Row="1" 
                    Background="#FF2D8C" 
                    Foreground="White" 
                    Cursor="Hand"
                    Margin="20,0,20,0"
                    Height="180"
                    VerticalAlignment="Top"
                    Click="AddTrip_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                    <TextBlock Text="Add Trip" FontSize="24" FontFamily="Comic Sans MS" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="2" 
                    Content="Back to Home" 
                    Height="45" 
                    Background="#3B1A66" 
                    Foreground="White" 
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="Back_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>


        <Border Grid.Column="1" 
                Background="#2B124C" 
                CornerRadius="25" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Your Trips" 
                           Foreground="White" 
                           FontSize="28" 
                           FontFamily="Comic Sans MS" 
                           FontWeight="Bold" 
                           Margin="10,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TripsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3B1A66" CornerRadius="15" Padding="15" Margin="0,0,10,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#CCCCCC" FontSize="14" Margin="0,2,0,8" TextWrapping="Wrap" FontStyle="Italic"/>

                                            <Rectangle Height="1" Fill="#555555" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>

                                            <Expander Header="Description" Foreground="White" FontSize="14" FontWeight="Bold">
                                                <TextBlock Text="{Binding Description, TargetNullValue='No description provided.', FallbackValue='No description provided.'}" Foreground="#CCCCCC" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </Expander>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,15,0">

                                            <Path Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z" 
                                                  Fill="#FF2D8C" 
                                                  Width="18" Height="18" 
                                                  Stretch="Uniform" 
                                                  Margin="0,0,5,0"/>

                                            <TextBlock Text="{Binding PeopleCount}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding DateDisplay}" Foreground="#FF2D8C" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>