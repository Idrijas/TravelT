<Window x:Class="Travelt.PlanningPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan a Trip" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1A0B2E">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,25,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="PLAN A TRIP!" 
                       Foreground="White" 
                       FontSize="45" 
                       FontFamily="Comic Sans MS" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,40"/>

            <Button Grid.Row="1" 
                    Background="#FF2D8C" 
                    Foreground="White" 
                    Cursor="Hand"
                    Margin="20,0,20,0"
                    Height="180"
                    VerticalAlignment="Top"
                    Click="AddTrip_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                    <TextBlock Text="Add Trip" FontSize="24" FontFamily="Comic Sans MS" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="2" 
                    Content="Back to Home" 
                    Height="45" 
                    Background="#3B1A66" 
                    Foreground="White" 
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="Back_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>


        <Border Grid.Column="1" 
                Background="#2B124C" 
                CornerRadius="25" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Your Trips" 
                           Foreground="White" 
                           FontSize="28" 
                           FontFamily="Comic Sans MS" 
                           FontWeight="Bold" 
                           Margin="10,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TripsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3B1A66" CornerRadius="15" Padding="15" Margin="0,0,10,15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#CCCCCC" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" FontStyle="Italic"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,15,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z" 
                              Fill="#FF2D8C" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding PeopleCount}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding DateDisplay}" Foreground="#FF2D8C" FontSize="16" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Rectangle Grid.Row="1" Height="1" Fill="#555555" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                            <Button Content="Edit" Click="EditTrip_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#AAAAAA" FontSize="14" FontWeight="Bold" Margin="0,0,15,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#FF2D8C"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Delete" Click="DeleteTrip_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#AAAAAA" FontSize="14" FontWeight="Bold">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#FF4444"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>

                                        <Grid Grid.Row="3" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Expander Header="Description" Foreground="#FF2D8C" FontSize="14" FontWeight="Bold" Margin="0,0,0,0">
                                                    <TextBlock Text="{Binding Description}" Foreground="#AAAAAA" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </Expander>

                                                <Expander Header="Members" Foreground="#FF2D8C" FontSize="14" FontWeight="Bold" Margin="0,5,0,0">
                                                    <ItemsControl ItemsSource="{Binding JoinedMembers}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" Margin="0,5,0,0"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="MemberAvatar_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,8,8" ToolTip="{Binding Username}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Ellipse Width="35" Height="35" Stroke="#FF2D8C" StrokeThickness="1">
                                                                                <Ellipse.Fill>
                                                                                    <ImageBrush ImageSource="{Binding ProfilePictureFullPath}" Stretch="UniformToFill"/>
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="Transparent" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>