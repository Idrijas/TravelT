<Window x:Class="TravelT.ProfilePageWindow"
        WindowState="Maximized"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Travelt"
        Title="ProfilePageWindow"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1A0B2E">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock x:Name="PageTitleText" 
                   Text="Your Profile"
                   Foreground="White"
                   FontSize="70"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>


        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="40*"/>
            </Grid.ColumnDefinitions>

            
            <Grid Grid.Column="0"
                        Margin="0,25,25,0">   <!-- this is the whole left side of the page-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="441"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                
                
                <Border Background="#2B124C"
                        Padding="75"            
                        Margin="0,0,0,15" 
                        Height="441"
                        Grid.Row="0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        
                        
                        
                        <Border Grid.Column="0"
                                Width="230"
                                Height="230"
                                Background="#FF2D8C"
                                HorizontalAlignment="Center">

                            <Image x:Name="ProfilePicturePlace"
                                   Width="230"
                                   Height="230"
                                   Stretch="UniformToFill"/>

                        </Border>

                        
                        
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    Margin="20,0,0,0">

                            <TextBlock x:Name="UsernameBlock"
                                       Text="Username"
                                       Foreground="White"
                                       FontSize="34"
                                       FontFamily="Comic Sans MS"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <TextBlock x:Name="AgeBlock"
                                       Text="Age: "
                                       Foreground="White"
                                       FontFamily="Comic Sans MS"
                                       FontSize="22"
                                       Margin="0,0,0,8"/>

                            <Button x:Name="RankButton"
                                    Content="Rank: Complete trips to rank-up"
                                    HorizontalAlignment="Left"
                                    Foreground="White"
                                    FontSize="22"
                                    FontFamily="Comic Sans MS"
                                    Margin="0,5,0,8"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Cursor="Hand"
                                    Click="ShowRankInfo"/>

                            

                            <TextBlock x:Name="NationalityBlock"
                                       Text="Nationality: "
                                       Foreground="White"
                                       FontFamily="Comic Sans MS"
                                       FontSize="22"
                                       Margin="0,5,0,8"/>

                            <Button x:Name="VisitedCountriesButton"
                                    Content="Countries visited: 0"
                                    Foreground="White"
                                    FontSize="22"
                                    FontFamily="Comic Sans MS"
                                    HorizontalAlignment="Left"
                                    Margin="0,5,0,8"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Cursor="Hand"
                                    Click="ShowCountriesInfo"/>

                            <TextBlock Text="You can edit your profile in Settings :)"
                                       Foreground="White"
                                       FontStyle="Italic"
                                       FontFamily="Comic Sans MS"
                                       FontSize="18"
                                       Margin="0,15,0,8"/>




                        </StackPanel>

      
                       
                    </Grid>
                    
                        
                </Border>

                <Expander Grid.Row="1" Header="Bio"
                          Background="#2B124C"
                          Foreground="White"
                          FontSize="22"
                          FontFamily="Comic Sans MS"
                          Padding="12"
                          Margin="0,0,0,15">
                    
                    

                    <TextBlock x:Name="BioExpander"
                               Text="Here will be Bio, probably max 200 characters (we can talk about it), can be editable"
                               Foreground="White"
                               FontFamily="Comic Sans MS"
                               FontSize="18"
                               TextWrapping="Wrap"
                               Margin="10"/>
                    
                    
                </Expander>

                <Expander Grid.Row="2" Header="Achievements"
                           Background="#2B124C"
                           Foreground="White"
                           FontSize="22"
                           FontFamily="Comic Sans MS"
                           Padding="12"
                           Margin="0,0,0,15">
                    <ItemsControl x:Name="AchievementsBlock" Margin="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="20"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        Click="Achievement_Show">

                                    <Image Source="{Binding IconUrl}"
                                           Width="65"
                                           Height="65"
                                           Opacity="{Binding Opacity}" />

                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>



                    <Expander Grid.Row="3"
                              Header="Plans"
                              Background="#2B124C"
                              Foreground="White"
                              FontSize="22"
                              FontFamily="Comic Sans MS"
                              Padding="12"
                              Margin="0,0,0,15">

                              <Button x:Name="PlansButton"
                                Content="See My Plans"
                                FontFamily="Comic Sans MS"
                                FontSize="20"
                                Foreground="White"
                                Background="Transparent"
                                BorderBrush="White"
                                BorderThickness="2"
                                Cursor="Hand"
                                Padding="15"
                                Margin="10"
                                Click="ToPlans_Button">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="White"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#8E44AD"/>
                                            <Setter Property="BorderBrush" Value="#C77DFF"/>
                                            <Setter Property="FontSize" Value="22"/>
                                        </Trigger>
                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                    </Expander>



                </Grid>

            <!-- The whole right side of the page -->
            
            <Border Grid.Column="1"
                    Background="#2B124C"
                    Padding="20" 
                    Margin="0,25,0,0">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="World Map"
                               Foreground="White"
                               FontSize="34"
                               FontFamily="Comic Sans MS"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,85"/>
                    
                        <Border Height="441"
                            Background="#3B1A66"
                            CornerRadius="15">

                            <Button Content="Open World Map"
                                    Click="OpenWorldMap"/>
                        </Border>
                </StackPanel>
            </Border>

        </Grid>

        <Grid Grid.Row="2"
              Margin="0,25,0,0">

            <Button Content="HomePage"
                    Width="160"
                    Height="45"
                    Foreground="White"
                    Background="#FF2D8C"
                    HorizontalAlignment="Left"
                    Click="ToHomePage_Button"/>

            <Button x:Name="SettingsButton"
                    Content="Settings"
                    Width="160"
                    Height="45"
                    Background="#FF2D8C"
                    Foreground="White"
                    HorizontalAlignment="Right"
                    Click="ToSettings_Button"/>

        </Grid>

      </Grid>
    </ScrollViewer>
</Window>