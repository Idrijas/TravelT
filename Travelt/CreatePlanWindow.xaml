<Window x:Class="Travelt.CreatePlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan a Trip" Height="650" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1A0B2E">

    <Border Background="#2B124C" CornerRadius="25" Margin="30" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" 
                       Grid.Row="0"
                       Text="WHERE TO, USER?" 
                       Foreground="White" 
                       FontSize="36" 
                       FontFamily="Comic Sans MS" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Destinations (Countries)" Foreground="White" FontSize="16" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CountrySearchBox" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="True" Height="35" FontSize="16" Margin="0,0,0,5" KeyDown="CountrySearchBox_KeyDown"/>
                    <ListBox x:Name="SelectedCountriesList" Height="80" Background="#3B1A66" Foreground="White" BorderThickness="0" Margin="0,0,0,15" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="✕" Width="20" Height="20" Background="#FF2D8C" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" Click="RemoveCountry_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <TextBlock Text="{Binding}" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Places (Cities, Parks, etc.)" Foreground="White" FontSize="16" Margin="0,0,0,5"/>
                    <TextBox x:Name="PlaceInputBox" Height="35" FontSize="16" Padding="5" Margin="0,0,0,5" KeyDown="PlaceInputBox_KeyDown" Tag="Type a place and press Enter..."/>
                    <ListBox x:Name="SelectedPlacesList" Height="80" Background="#3B1A66" Foreground="White" BorderThickness="0" Margin="0,0,0,15" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="✕" Width="20" Height="20" Background="#FF2D8C" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" Click="RemovePlace_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <TextBlock Text="{Binding}" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <CheckBox x:Name="FlexibleDatesCheck" Content="My dates are flexible" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Click="FlexibleDatesCheck_Click"/>

                    <StackPanel x:Name="ExactDatesPanel">
                        <TextBlock Text="Date From" Foreground="White" FontSize="16" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DateFromPicker" Height="35" FontSize="16" Margin="0,0,0,10"/>
                        <TextBlock Text="Date To" Foreground="White" FontSize="16" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DateToPicker" Height="35" FontSize="16" Margin="0,0,0,15"/>
                    </StackPanel>

                    <StackPanel x:Name="FlexibleDatesPanel" Visibility="Collapsed" Margin="0,0,0,15">

                        <CheckBox x:Name="AnytimeCheck" Content="I can go ANYTIME!" Foreground="#FF2D8C" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Click="AnytimeCheck_Click"/>

                        <StackPanel x:Name="MonthSelectionPanel">
                            <TextBlock Text="Select Month(s)" Foreground="White" FontSize="16" Margin="0,0,0,5"/>
                            <ComboBox x:Name="MonthSearchBox" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="True" Height="35" FontSize="16" Margin="0,0,0,5" KeyDown="MonthSearchBox_KeyDown" Tag="Type a month..."/>
                            <ListBox x:Name="SelectedMonthsList" Height="80" Background="#3B1A66" Foreground="White" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Button Content="✕" Width="20" Height="20" Background="#FF2D8C" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" Click="RemoveMonth_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="10"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock Text="{Binding}" FontSize="15" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="People?" Foreground="White" FontSize="16" Margin="0,0,0,5"/>
                            <TextBox x:Name="MaxPeopleInput" Height="35" FontSize="16" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Trip Type" Foreground="White" FontSize="16" Margin="0,0,0,5"/>
                            <ComboBox x:Name="TripTypeCombo" Height="35" FontSize="16" SelectedIndex="0">
                                <ComboBoxItem Content="Vacation" Tag="vacation"/>
                                <ComboBoxItem Content="City Trip" Tag="city_trip"/>
                                <ComboBoxItem Content="Roadtrip" Tag="roadtrip"/>
                                <ComboBoxItem Content="Backpacking" Tag="backpacking"/>
                                <ComboBoxItem Content="Camping" Tag="camping"/>
                                <ComboBoxItem Content="Hikes" Tag="hikes"/>
                                <ComboBoxItem Content="Business" Tag="business"/>
                                <ComboBoxItem Content="Other" Tag="other"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description" Foreground="White" FontSize="16" Margin="0,0,0,5"/>
                    <TextBox x:Name="DescriptionInput" Height="60" FontSize="16" Padding="5" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="MakePrivateCheck" Content="Make Private" Foreground="White" FontSize="14"/>
                    </StackPanel>

                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="Cancel" 
                        Height="45" Width="150" 
                        Background="#3B1A66" 
                        Foreground="White" 
                        FontSize="18" FontWeight="Bold" Cursor="Hand"
                        HorizontalAlignment="Left"
                        Click="Cancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" 
                        Content="ADD TRIP" 
                        Height="45" Width="150" 
                        Background="#FF2D8C" 
                        Foreground="White" 
                        FontSize="18" FontWeight="Bold" Cursor="Hand"
                        HorizontalAlignment="Right"
                        Click="AddTrip_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>