<Window x:Class="Travelt.DiscoveryPageWindow"
        WindowState="Maximized"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Travelt"
        mc:Ignorable="d"
        Title="Discovery Feed" Height="600" Width="900">
    <Window.Resources>
        <Style x:Key="IconToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,8" Margin="0,0,5,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#FF2D8C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4B227A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#1A001F">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,30">

                <Border Background="#2B124C" CornerRadius="15" Padding="5" Margin="0,0,0,20" Height="60" Width="675" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,0,10,0">
                            <RadioButton x:Name="PostsToggle" GroupName="SearchTabs" IsChecked="True" Style="{StaticResource IconToggleStyle}" Checked="PostsToggle_Checked">
                                <Path Data="M21,19V5C21,3.89 20.1,3 19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="24" Height="24" Stretch="Uniform"/>
                            </RadioButton>

                            <RadioButton x:Name="PeopleToggle" GroupName="SearchTabs" Style="{StaticResource IconToggleStyle}" Checked="PeopleToggle_Checked">
                                <Path Data="M16,11C17.66,11 19,9.66 19,8C19,6.34 17.66,5 16,5C14.34,5 13,6.34 13,8C13,9.66 14.34,11 16,11M8,11C9.66,11 11,9.66 11,8C11,6.34 9.66,5 8,5C6.34,5 5,6.34 5,8C5,9.66 6.34,11 8,11M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M16,13C15.71,13 15.38,13.02 15.03,13.05C16.19,13.89 17,15.02 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="24" Height="24" Stretch="Uniform"/>
                            </RadioButton>

                            <RadioButton x:Name="TripsToggle" GroupName="SearchTabs" Style="{StaticResource IconToggleStyle}" Checked="TripsToggle_Checked">
                                <Path Data="M21,16V14L13,9V3.5A1.5,1.5 0 0,0 11.5,2A1.5,1.5 0 0,0 10,3.5V9L2,14V16L10,13.5V19L8,20.5V22L11.5,21L15,22V20.5L13,19V13.5L21,16Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="24" Height="24" Stretch="Uniform"/>
                            </RadioButton>
                        </StackPanel>

                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="White" FontSize="18" BorderThickness="0" VerticalContentAlignment="Center" Margin="5,0" KeyDown="SearchBox_KeyDown"/>

                        <Button Grid.Column="2" Content="Search" Background="#FF2D8C" Foreground="White" FontSize="16" FontWeight="Bold" Width="100" Cursor="Hand" Click="SearchButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <ItemsControl x:Name="PostsFeed" Visibility="Visible">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:PostUI HorizontalAlignment="Center" Width="675"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="PeopleFeed" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PersonCard_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#2B124C" BorderBrush="#FF2D8C" BorderThickness="1" CornerRadius="15" Padding="15" Margin="0,0,0,15" Width="675" HorizontalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Width="55" Height="55" Stroke="#FF2D8C" StrokeThickness="2">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding ProfilePictureFullPath}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                                    <TextBlock Foreground="White" FontSize="20" FontWeight="Bold">
                                                        <Run Text="{Binding FirstName}"/> <Run Text="{Binding LastName}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Username, StringFormat='@{0}'}" Foreground="#FF2D8C" FontSize="15" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="TripsFeed" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#3B1A66" CornerRadius="15" Padding="15" Margin="0,0,0,15" Width="675" HorizontalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#CCCCCC" FontSize="14" Margin="0,2,0,8" TextWrapping="Wrap" FontStyle="Italic"/>
                                        <Rectangle Height="1" Fill="#555555" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                        <Expander Header="Description" Foreground="#FF2D8C" FontSize="14" FontWeight="Bold">
                                            <TextBlock Text="{Binding Description, TargetNullValue='No description provided.', FallbackValue='No description provided.'}" Foreground="#AAAAAA" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </Expander>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,15,0">
                                        <Path Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z" 
                                              Fill="#FF2D8C" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding PeopleCount}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding DateDisplay}" Foreground="#FF2D8C" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Label x:Name="noresultslabel"
               Grid.Row="0"
               Content="No results found :("
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" 
               FontSize="30" 
               Foreground="White" 
               FontWeight="Bold" 
               Visibility="Collapsed">
        </Label>

        <Grid Grid.Row="2"
              Width="675"
              Height="60"
              Margin="0,0,0,15">

            <Button Content="HomePage"
                    Width="160"
                    Height="45"
                    Foreground="White"
                    Background="#FF2D8C"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Click="ToHomePage_Button">
                
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Make Post"
                    Width="160"
                    Height="45"
                    Foreground="White"
                    Background="#FF2D8C"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Click="OpenCreatePost_Click">

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="To Profile"
                    Width="160"
                    Height="45"
                    Margin="0,0,17,0"
                    Background="#FF2D8C"
                    Foreground="White"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    Click="ToProfile_Button">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

        </Grid>

    </Grid>
</Window>