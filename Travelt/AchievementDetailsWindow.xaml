<Window x:Class="Travelt.AchievementDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievement"
        Height="350"
        Width="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Border CornerRadius="15"
            Background="#2A2A2A"
            Margin="10"
            Padding="20">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Image x:Name="AchievementIcon"
                   Width="120"
                   Height="120"
                   Margin="0,0,0,15"/>

            <TextBlock x:Name="AchievementTitle"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="AchievementDescription"
                       FontSize="14"
                       Foreground="LightGray"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <Button Content="Close"
                    Width="100"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="Close_Button"/>

        </StackPanel>

    </Border>

</Window>
