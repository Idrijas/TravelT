<Window x:Class="Travelt.ReportUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report User"
        Height="430"
        Width="520"
        Background="#1A0B2E"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Report User"
                   Foreground="White"
                   FontSize="42"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Reason"
                       Foreground="White"
                       FontSize="20"
                       FontFamily="Comic Sans MS"
                       Margin="0,0,0,8"/>

            <ComboBox x:Name="ReasonComboBox"
                      Height="35"
                      FontSize="16">
                <ComboBoxItem Content="Spam"/>
                <ComboBoxItem Content="Harassment"/>
                <ComboBoxItem Content="Fake Profile"/>
                <ComboBoxItem Content="Inappropriate Profile"/>
                <ComboBoxItem Content="Scam Profile"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Description"
                       Foreground="White"
                       FontSize="20"
                       FontFamily="Comic Sans MS"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="DescriptionTextBox"
                     Height="140"
                     FontSize="16"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,25,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Back"
                    Width="160"
                    Height="45"
                    Foreground="White"
                    Background="#FF2D8C"
                    HorizontalAlignment="Left"
                    Click="Back_Button"/>

            <Button Content="Submit Report"
                    Grid.Column="1"
                    Width="170"
                    Height="45"
                    Foreground="White"
                    Background="#FF2D8C"
                    HorizontalAlignment="Right"
                    Click="SubmitReport_Button"/>
        </Grid>
    </Grid>
</Window>