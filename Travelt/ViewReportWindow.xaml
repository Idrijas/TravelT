<Window x:Class="Travelt.ViewReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Report"
        Height="550"
        Width="700"
        Background="#1A0B2E"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Report Details"
                   Foreground="White"
                   FontSize="44"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <Border Grid.Row="1"
                Background="#2B124C"
                Padding="25"
                CornerRadius="15">

            <StackPanel>

                <TextBlock x:Name="ReportId_Text"
                           Text="Report ID:"
                           Foreground="White"
                           FontSize="18"
                           FontFamily="Comic Sans MS"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="Reporter_Text"
                           Text="Reporter:"
                           Foreground="White"
                           FontSize="18"
                           FontFamily="Comic Sans MS"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="ReportedUser_Text"
                           Text="Reported User:"
                           Foreground="White"
                           FontSize="18"
                           FontFamily="Comic Sans MS"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="Reason_Text"
                           Text="Reason:"
                           Foreground="White"
                           FontSize="18"
                           FontFamily="Comic Sans MS"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="Date_Text"
                           Text="Date:"
                           Foreground="White"
                           FontSize="18"
                           FontFamily="Comic Sans MS"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Description:"
                           Foreground="White"
                           FontSize="22"
                           FontFamily="Comic Sans MS"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="Description_Text"
                         Height="180"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         FontSize="16"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Content="Close"
                Width="160"
                Height="45"
                Background="#FF2D8C"
                Foreground="White"
                HorizontalAlignment="Center"
                Margin="0,25,0,0"
                Click="Close_Button"/>
    </Grid>
</Window>