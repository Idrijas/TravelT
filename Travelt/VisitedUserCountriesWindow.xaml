<Window x:Class="Travelt.VisitedUserCountriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Travelt"
        mc:Ignorable="d"
        Title="VisitedUserCountriesWindow" Height="450" Width="800">
    <Grid Background="#1A001F">
        <StackPanel Margin="20">

            <TextBlock Text="Visited Countries"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="White"
                       FontFamily="Comic Sans MS"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

          
            <ListBox x:Name="VisitedCountriesListBox_User"
                       DisplayMemberPath="CountryName"
                       Margin="0,20,0,0"
                       Height="250"
                       Width="300"
                       HorizontalAlignment="Center"
                       FontSize="18"/>

        </StackPanel>
        <Button Content="Back"
             Width="150"
             Height="35"
             Background="#FF2D8C"
             Foreground="White"
             HorizontalAlignment="Left"
             VerticalAlignment="Bottom"
             Click="Back_Button_User"/>
    </Grid>
</Window>
